{name === 'bilibili' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6.5" width="18" height="13" rx="3" /><path d="m8 3 2.5 3.5M16 3l-2.5 3.5M9 12v2M15 12v2" /></svg>
