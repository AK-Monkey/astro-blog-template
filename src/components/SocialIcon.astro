{name === 'wechat' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.2 8.6C15.5 5.4 12.3 3 8.6 3 4.4 3 1.5 5.8 1.5 9.1c0 1.9 1 3.6 2.6 4.7l-.6 2.3 2.7-1.4c.8.2 1.5.3 2.4.3" /><path d="M15.6 9.2c-3.6 0-6.4 2.4-6.4 5.4s2.8 5.4 6.4 5.4c.7 0 1.4-.1 2-.3l2.4 1.3-.6-2.1c1.6-1 2.6-2.5 2.6-4.3 0-3-2.8-5.4-6.4-5.4Z" /><circle cx="6" cy="8.2" r=".6" fill="currentColor" /><circle cx="11" cy="8.2" r=".6" fill="currentColor" /><circle cx="13.4" cy="13.6" r=".55" fill="currentColor" /><circle cx="17.8" cy="13.6" r=".55" fill="currentColor" /></svg>
