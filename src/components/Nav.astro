---
import { siteConfig } from '../site.config';
import Logo from './Logo.astro';
import SettingsButton from './SettingsButton.astro';
import SearchButton from './SearchButton.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<nav class="nav" aria-label="主导航">
  <div class="inner">
    <a class="brand" href="/" aria-label={siteConfig.title}><Logo />{siteConfig.name}</a>
    <ul>
      {siteConfig.nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.href === '/posts/' ? siteConfig.postsLabel : item.label}</a></li>
      ))}
      <li>
        <button class="icon-btn" type="button" data-cycle-theme title="切换主题" aria-label="切换主题">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" /></svg>
        </button>
      </li>
      <li><SearchButton /></li>
      {siteConfig.displaySettings && <li><SettingsButton /></li>}
    </ul>
  </div>
</nav>
