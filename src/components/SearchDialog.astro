---
import { siteConfig } from '../site.config';
// 站内搜索对话框。索引由 Pagefind 在构建后生成（只收录带 data-pagefind-body 的内容）。
---
<dialog id="site-search" class="search" aria-label="站内搜索">
  <form method="dialog" class="search-head" role="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input type="search" name="q" placeholder={`搜索${siteConfig.postsLabel}…`} autocomplete="off" spellcheck="false" aria-label="搜索关键词" aria-controls="search-results" />
    <button type="submit" class="search-close" value="close" aria-label="关闭搜索">Esc</button>
  </form>
  <div class="search-status" aria-live="polite"></div>
  <ol id="search-results" class="search-results"></ol>
</dialog>
