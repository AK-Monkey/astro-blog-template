---
import { formatDate, postPath, type Post } from '../lib/posts';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((post) => (
    <li>
      <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
      <span>
        {post.data.draft && <span class="draft">草稿</span>}
        <a href={postPath(post.id)}>{post.data.title}</a>
        {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
      </span>
    </li>
  ))}
</ul>
