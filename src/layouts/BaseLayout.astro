---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import '../styles/global.css';

import { siteConfig } from '../site.config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DisplaySettings from '../components/DisplaySettings.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  /** 页面标题；省略时只显示站点名 */
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** article 专用 */
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description = siteConfig.description,
  lang = 'zh',
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const fullTitle = title
  ? `${title} | ${siteConfig.title}`
  : siteConfig.tagline
    ? `${siteConfig.title} | ${siteConfig.tagline}`
    : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl).href;
const d = siteConfig.displayDefaults;
const enabled = siteConfig.displaySettings;
const htmlLang = lang === 'en' ? 'en' : 'zh-CN';
const ogLocale = lang === 'en' ? 'en_US' : 'zh_CN';
---
<!doctype html>
<html
  lang={htmlLang}
  data-layout={d.layout}
  data-font={d.font}
  data-theme={d.theme}
  data-logo={d.logo}
  data-display-settings={String(enabled)}
  data-storage-key={siteConfig.storageKey}
>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:site_name" content={siteConfig.title} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title ?? siteConfig.title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title ?? siteConfig.title} />
  <meta name="twitter:description" content={description} />
  {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {ogType === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

  <slot name="head" />

  <!--
    首屏绘制前把本地保存的显示设置写到 <html> 的 data-* 上，避免闪烁。
    displaySettings 关闭时只恢复主题（导航栏的主题循环按钮仍可用）。
  -->
  <script is:inline define:vars={{ storageKey: siteConfig.storageKey, enabled }}>
    (function () {
      var allowed = {
        layout: ['a', 'b', 'c'],
        font: ['serif', 'sans', 'mix'],
        theme: ['auto', 'light', 'dark'],
        logo: ['on', 'off'],
      };
      var keys = enabled ? ['layout', 'font', 'theme', 'logo'] : ['theme'];
      try {
        var saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
        var root = document.documentElement;
        keys.forEach(function (k) {
          if (saved && allowed[k].indexOf(saved[k]) > -1) root.dataset[k] = saved[k];
        });
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <Nav />
  <main class="wrap">
    <slot />
  </main>
  <div class="wrap"><Footer /></div>
  {enabled && <DisplaySettings />}
  <SearchDialog />
  {/* Vercel Web Analytics：无 Cookie；脚本由 Vercel 从本站域名 /_vercel/insights 提供，本地开发不上报 */}
  <Analytics />
  <script>
    import '../scripts/display';
    import '../scripts/search';
    import '../scripts/mail';
  </script>
</body>
</html>
